config MACH_INGENIC_GENERIC
	bool
	select MACH_INGENIC
	select MACH_JZ4740
	select MACH_JZ4725B
	select MACH_JZ4770
	select MACH_JZ4780
	select MACH_X1000
	select MACH_X1830

choice
	prompt "Machine type"
	depends on MACH_INGENIC_SOC
	default INGENIC_GENERIC_BOARD

config INGENIC_GENERIC_BOARD
	bool "Generic board"
	select MACH_INGENIC_GENERIC

config JZ4740_QI_LB60
	bool "Qi Hardware Ben NanoNote"
	select MACH_JZ4740

config JZ4740_RS90
	bool "YLM RetroMini (RS-90)"
	select MACH_JZ4725B

config JZ4770_GCW0
	bool "Game Consoles Worldwide GCW Zero"
	select MACH_JZ4770

config JZ4780_CI20
	bool "MIPS Creator CI20"
	select MACH_JZ4780

config X1000_CU1000_NEO
	bool "YSH & ATIL CU1000 Module with Neo backplane"
	select MACH_X1000

config X1830_CU1830_NEO
	bool "YSH & ATIL CU1830 Module with Neo backplane"
	select MACH_X1830

config X2000_CREALITY_K1
	bool "Creality K1"
	select MACH_X2000

endchoice

config MACH_JZ4725B
	bool
	select SYS_HAS_CPU_MIPS32_R1

config MACH_JZ4740
	bool
	select SYS_HAS_CPU_MIPS32_R1

config MACH_JZ4770
	bool
	select MIPS_CPU_SCACHE
	select SYS_HAS_CPU_MIPS32_R2
	select SYS_SUPPORTS_HIGHMEM

config MACH_JZ4780
	bool
	select MIPS_CPU_SCACHE
	select SYS_HAS_CPU_MIPS32_R2
	select SYS_SUPPORTS_HIGHMEM

config MACH_X1000
	bool
	select MIPS_CPU_SCACHE
	select SYS_HAS_CPU_MIPS32_R2
	select SYS_SUPPORTS_HIGHMEM

config MACH_X1830
	bool
	select MIPS_CPU_SCACHE
	select SYS_HAS_CPU_MIPS32_R2
	select SYS_SUPPORTS_HIGHMEM

# The X2000's CPU is an XBurst2: two CPUs that are threads of one core, of
# MIPS32 release 5 without ERETNC. What its CPU feature overrides say holds
# for it alone, so it is not part of the generic board's kernel. No CPU
# hotplug: see arch/mips/kernel/smp-xburst2.c.
config MACH_X2000
	bool
	select HARDIRQS_SW_RESEND
	select MIPS_O32_FP64_SUPPORT
	select SMP_UP if SMP
	select SYS_HAS_CPU_MIPS32_R2
	select SYS_HAS_CPU_MIPS32_R5
	select SYS_SUPPORTS_HIGHMEM
	select SYS_SUPPORTS_SMP
	select WEAK_ORDERING
	select WEAK_REORDERING_BEYOND_LLSC
	select XBURST2_CPU_SCACHE

config XBURST2_SMP
	def_bool SMP && MACH_X2000
