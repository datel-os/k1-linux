// SPDX-License-Identifier: GPL-2.0
/*
 * Creality K1, mainboard CR4CU220812S11/S12: an Ingenic X2000 with 256 MiB
 * of RAM, 8 GB of eMMC, a CYW43438 Wi-Fi and Bluetooth module, three GD32
 * microcontrollers on UARTs and a USB hub with the camera behind it.
 *
 * What is wired to what comes from the printer's stock firmware 1.3.3.46:
 * its device tree as the running kernel showed it, the state of its GPIOs
 * and pin multiplexer, and the parameters of its modules. Datel OS's Yocto
 * layer keeps them (hardware/). Where this file differs from the tree
 * Datel OS ran on the SDK's 6.6 kernel, a comment says so.
 *
 * Not described: the display (an ST7701 panel on the LCD controller, its
 * backlight) and the touch controller; no driver here knows them.
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>

#include "x2000.dtsi"

/ {
	model = "Creality K1";
	compatible = "creality,k1", "ingenic,x2000";

	chosen {
		stdout-path = "serial2:115200n8";
	};

	/*
	 * The boot loader names the memory on the command line (mem=256M@0x0),
	 * so there is no memory node. The two areas here are the top 33 MiB of
	 * those 256.
	 */
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/*
		 * The kernel log and the last panic, kept over a reset; they
		 * show under /sys/fs/pstore after the next boot.
		 */
		ramoops@df00000 {
			compatible = "ramoops";
			reg = <0x0df00000 0x00100000>;
			record-size = <0x10000>;
			console-size = <0x80000>;
			pmsg-size = <0x40000>;
			ecc-size = <16>;
			mem-type = <1>;
		};

		/*
		 * What the Helix codec works on: programs get their buffers
		 * from here through /dev/helix. The stock firmware keeps
		 * 36 MiB at 0x05000000 for the same purpose.
		 *
		 * no-map: the pool code maps the area itself and refuses
		 * memory the kernel has in use as RAM. The SDK kernel changed
		 * that code instead and picked the area by the size of the
		 * RAM (reg-64M, reg-128M, reg-256M); a K1 has one size.
		 */
		helix_pool: helix-pool@e000000 {
			compatible = "shared-dma-pool";
			reg = <0x0e000000 0x02000000>;
			no-map;
		};
	};

	/*
	 * One supply for both halves of the Wi-Fi and Bluetooth module,
	 * switched by PA1. A fixed regulator's line is active low unless
	 * enable-active-high says otherwise, whatever the flag in the cell.
	 */
	wifi_bt_power: regulator-wifi-bt {
		compatible = "regulator-fixed";
		regulator-name = "wifi_bt_power";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpa 1 GPIO_ACTIVE_LOW>;
		regulator-always-on;
		regulator-boot-on;
	};

	/*
	 * The board's 3.3 V rail, on whenever the board has power. Nothing
	 * switches it; it is here because the USB transceiver's binding asks
	 * for the transceiver's supply.
	 */
	vcc_3v3: regulator-vcc-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	/*
	 * VBUS of the USB port: PA15, high for on, as the stock firmware
	 * drives it while the port is a host.
	 *
	 * Datel OS's tree for the 6.6 kernel had the Halley5 board's lines
	 * instead, PC9 to switch VBUS and PD17 to sense it, and left PA15 an
	 * input, which reads low. The hub and the camera worked like that, so
	 * PA15 switches something behind them: the USB socket, most likely.
	 */
	usb_vbus: regulator-usb-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb_vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&gpa 15 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	/*
	 * WL_REG_ON, PE2: low holds the Wi-Fi half of the module in reset. The
	 * MMC core lets go of the line when it powers the SDIO host up, and
	 * then waits 200 ms before the first command, for the chip to start.
	 * The wait cannot be left to the scan's retries: a scan that fails
	 * pulls the line low again.
	 */
	wifi_pwrseq: wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&gpe 2 GPIO_ACTIVE_LOW>;
		post-power-on-delay-ms = <200>;
	};

	/* The mainboard's status LED. No LED driver is in k1_defconfig. */
	leds {
		compatible = "gpio-leds";

		led-sys {
			label = "sys-led";
			gpios = <&gpa 13 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};
	};

	/*
	 * Not nodes, but wired: PA10 (SWDIO), PA6 (SWCLK) and PA7 (reset,
	 * active low) are the debug port of the mainboard's microcontroller.
	 * They stay plain GPIOs, for OpenOCD.
	 */
};

&exclk {
	clock-frequency = <24000000>;
};

/*
 * The CPU and its L2 cache run on the APLL, which the boot loader sets to
 * 1200 MHz. At that speed this board computes wrong floating point results
 * now and then (a few in a million repetitions of a fixed calculation on one
 * CPU, a few in a thousand with both CPUs busy), more when it is warm; the
 * same kernel and the same program give none at 912 MHz and below. Klipper
 * turns such a result into a step that lies before the previous one and
 * shuts the printer down. 816 MHz is one step of 96 MHz below the highest
 * clean rate that was measured.
 */
&cgu {
	assigned-clocks = <&cgu X2000_CLK_APLL>;
	assigned-clock-rates = <816000000>;
};

&pinctrl {
	/*
	 * The supply of two pin banks, as the stock firmware has them: port A
	 * at 3.3 V, port E at 1.8 V. Port E carries the module's control
	 * lines and its 32 kHz clock. The board code reads these two
	 * (arch/mips/generic/board-ingenic-x2000.c); the pin control driver's
	 * binding does not know them.
	 */
	ingenic,gpa-microvolt = <3300000>;
	ingenic,gpe-msc-microvolt = <1800000>;

	/*
	 * No node here asks for a pull: the pins keep the pulls the boot
	 * loader left, as they did under the SDK's driver.
	 */

	/*
	 * TX and RX alone (PC23, PC24). The port's RTS and CTS would be PC21
	 * and PC22; on this board PC21 switches the panel's supply and PC22
	 * is its backlight.
	 */
	pins_uart1: uart1 {
		function = "uart1";
		groups = "uart1-data";
	};

	/* PD30, PD31 */
	pins_uart2: uart2 {
		function = "uart2";
		groups = "uart2-data";
	};

	/* PD2, PD3, and RTS and CTS on PD0, PD1 */
	pins_uart3: uart3 {
		function = "uart3";
		groups = "uart3-data-d", "uart3-hwflow-d";
	};

	/* PA4, PA5 */
	pins_uart5: uart5 {
		function = "uart5";
		groups = "uart5-data-a";
	};

	/* PA8, PA9 */
	pins_uart7: uart7 {
		function = "uart7";
		groups = "uart7-data-a";
	};

	/* PB30, PB31 */
	pins_uart9: uart9 {
		function = "uart9";
		groups = "uart9-data";
	};

	/* PB22, PB23 */
	pins_i2c2: i2c2 {
		function = "i2c2";
		groups = "i2c2-data-b";
	};

	/* PC25, PC26 */
	pins_i2c4: i2c4 {
		function = "i2c4";
		groups = "i2c4-data-c";
	};

	/* PD17 to PD26: clock, command, reset and eight data lines */
	pins_mmc0: mmc0 {
		function = "mmc0";
		groups = "mmc0-1bit", "mmc0-4bit", "mmc0-8bit";
	};

	/* PD8 to PD13: clock, command and four data lines */
	pins_mmc1: mmc1 {
		function = "mmc1";
		groups = "mmc1-1bit", "mmc1-4bit";
	};

	/* PE23 as the RTC's 32 kHz clock output, which the Wi-Fi module runs on */
	pins_clk32k: clk32k {
		function = "clk32k";
		groups = "clk32k";
	};
};

/* ttyS1: the microcontroller on the print head (GD32F303CBT6) */
&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pins_uart1>;
	status = "okay";
};

/* ttyS2: the console, on the header J1 */
&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pins_uart2>;
	status = "okay";
};

/*
 * ttyS3: the Bluetooth half of the module, with RTS and CTS. Its power-on
 * line is PE0, its wake-up lines PE3 (to the module) and PE1 (from it). No
 * driver is bound here: a program that wants Bluetooth sets PE0 and attaches
 * the port.
 */
&uart3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pins_uart3>;
	status = "okay";
};

/* ttyS5: on in the stock firmware; what it is wired to is not known */
&uart5 {
	pinctrl-names = "default";
	pinctrl-0 = <&pins_uart5>;
	status = "okay";
};

/* ttyS7: the mainboard's microcontroller (GD32F303RET6) */
&uart7 {
	pinctrl-names = "default";
	pinctrl-0 = <&pins_uart7>;
	status = "okay";
};

/*
 * ttyS9: the levelling microcontroller, on the bed's strain gauges
 * (GD32E230F8P6)
 */
&uart9 {
	pinctrl-names = "default";
	pinctrl-0 = <&pins_uart9>;
	status = "okay";
};

/*
 * A BL24C16F EEPROM at 0x50. It has no node: Klipper reads it through
 * /dev/i2c-2, and a kernel driver on that address would keep it out.
 */
&i2c2 {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pins_i2c2>;
	status = "okay";
};

/*
 * The bus of the touch controller (reset on PA0, interrupt on PA3). The
 * controller has no node: the GT911 node of Datel OS's tree for the 6.6
 * kernel did not answer at 0x14 on the printer this was written with, and
 * nothing would use it without the display.
 */
&i2c4 {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pins_i2c4>;
	status = "okay";
};

&dtrng {
	status = "okay";
};

/* The eMMC */
&msc0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pins_mmc0>;
	bus-width = <8>;
	max-frequency = <100000000>;
	cap-mmc-highspeed;
	mmc-hs200-1_8v;
	non-removable;
	status = "okay";
};

/*
 * The Wi-Fi half of the module, on SDIO. The MMC core powers it up through
 * the power sequence (WL_REG_ON). The 32 kHz clock the module needs comes
 * out of PE23 from the moment the host is probed, before that line rises.
 */
&msc1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pins_mmc1>, <&pins_clk32k>;
	bus-width = <4>;
	max-frequency = <100000000>;
	cap-sd-highspeed;
	sd-uhs-sdr104;
	cap-sdio-irq;
	non-removable;
	keep-power-in-suspend;
	vmmc-supply = <&wifi_bt_power>;
	mmc-pwrseq = <&wifi_pwrseq>;
	status = "okay";
};

/*
 * The port is a host port and nothing senses VBUS. The SDK's driver switched
 * the transceiver's VBUS comparator off for that; upstream's leaves it as it
 * comes out of reset, and the port does not care.
 */
&otg_phy {
	vcc-supply = <&vcc_3v3>;
	status = "okay";
};

/*
 * A host port with a hub on the board; the camera is behind the hub.
 *
 * ingenic,host-dma-desc: descriptor DMA, in which the controller reports
 * once per transfer and not once per microframe. Without it the camera's
 * stream meant 8500 interrupts a second.
 */
&otg {
	dr_mode = "host";
	disable-over-current;
	ingenic,host-dma-desc;
	vbus-supply = <&usb_vbus>;
	status = "okay";
};

/* H.264 and JPEG encoder, JPEG decoder: the camera stream and the timelapse */
&helix {
	memory-region = <&helix_pool>;
	status = "okay";
};
