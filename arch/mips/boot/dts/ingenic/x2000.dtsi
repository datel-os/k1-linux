// SPDX-License-Identifier: GPL-2.0
/*
 * Ingenic X2000, in the bindings of the SDK's drivers (module_drivers/).
 *
 * From the SDK kernel 6.6 (module_drivers/dts/x2000/x2000.dtsi), cut down to
 * the blocks this tree has a driver for. The USB controller is the one node
 * in the binding of an upstream driver (dwc2).
 */

#include <dt-bindings/interrupt-controller/x2000-irq.h>
#include <dt-bindings/clock/ingenic-x2000.h>
#include <dt-bindings/gpio/ingenic-gpio.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	compatible = "ingenic,x2000";

	aliases: aliases {
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		i2c2 = &i2c2;
		i2c3 = &i2c3;
		i2c4 = &i2c4;
		i2c5 = &i2c5;
		serial0 = &uart0;
		serial1 = &uart1;
		serial2 = &uart2;
		serial3 = &uart3;
		serial4 = &uart4;
		serial5 = &uart5;
		serial6 = &uart6;
		serial7 = &uart7;
		serial8 = &uart8;
		serial9 = &uart9;
		mmc0 = &msc0;
		mmc1 = &msc1;
		mmc2 = &msc2;
	};

	cpus: cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "ingenic,xburst2";
			reg = <0x000>;
		};

		cpu1: cpu@1 {
			device_type = "cpu";
			compatible = "ingenic,xburst2";
			reg = <0x001>;
		};
	};

	cpuintc: interrupt-controller {
		#address-cells = <0>;
		#interrupt-cells = <1>;
		interrupt-controller;
		compatible = "ingenic,cpu-interrupt-controller";
	};

	core_intc: core-intc@12300000 {
		compatible = "ingenic,core-intc";
		reg = <0x12300000 0x1000>,
		    <0x10001000 0x1000>;
		interrupt-controller;
		#interrupt-cells = <1>;
		cpu-intc-map = <0 0x000>,
			       <1 0x100>;

		interrupt-parent = <&cpuintc>;
		interrupts = <CORE_INTC_IRQ>;
		interrupt-names ="intc";
	};

	core_ost: core-ost@12000000 {
		compatible = "ingenic,core-ost";
		reg = <0x12000000 0x10000>, /*Global ost*/
		      <0x12100000 0x10000>; /*Core ost*/
		interrupt-parent = <&cpuintc>;
		interrupt-names = "sys_ost";
		interrupts = <CORE_SYS_OST_IRQ>;
		cpu-ost-map = 	<0 0x000>,
				<1 0x100>;
	};

	extclk: extclk {
		compatible = "ingenic,fixed-clock";
		clock-output-names ="ext";
		#clock-cells = <0>;
		clock-frequency  = <24000000>;
	};

	rtcclk: rtcclk {
		compatible = "ingenic,fixed-clock";
		clock-output-names ="rtc_ext";
		#clock-cells = <0>;
		clock-frequency = <32768>;
	};

	apb {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <>;

		clock: clock-controller@10000000 {
			compatible = "ingenic,x2000-clocks";
			reg = <0x10000000 0x100>;
			clocks = <&extclk>, <&rtcclk>;
			clock-names = "ext", "rtc_ext";
			#clock-cells = <1>;
			little-endian;
		};

		watchdog: watchdog@10002000 {
			compatible = "ingenic,watchdog";
			reg = <0x10002000 0x40>;
			interrupt-parent = <&core_intc>;
			interrupts = <IRQ_TCU0>;
			status = "ok";
		};

		rtc: rtc@10003000 {
			compatible = "ingenic,rtc";
			reg = <0x10003000 0x4c>;
			interrupt-parent = <&core_intc>;
			interrupts = <IRQ_RTC>;
			system-power-controller;
			power-on-press-ms = <1000>;
			status = "ok";
		};

		pinctrl: pinctrl@10010000 {
			compatible = "ingenic,x2000-pinctrl";
			reg = <0x10010000 0x1000>;
			ingenic,num-chips = <5>;
			ingenic,regs-offset = <0x100>;

			gpa: gpa {
				gpio-controller;
				#gpio-cells = <3>;
				#ingenic,pincfg-cells = <3>;
				#ingenic,pinmux-cells = <2>;
				interrupts = <IRQ_GPIO0>;
				interrupt-parent = <&core_intc>;
				interrupt-controller;
				#interrupt-cells = <2>;
			};

			gpb: gpb {
				gpio-controller;
				#gpio-cells = <3>;
				#ingenic,pincfg-cells = <3>;
				#ingenic,pinmux-cells = <2>;
				interrupts = <IRQ_GPIO1>;
				interrupt-parent = <&core_intc>;
				interrupt-controller;
				#interrupt-cells = <2>;
			};

			gpc: gpc {
				gpio-controller;
				#gpio-cells = <3>;
				#ingenic,pincfg-cells = <3>;
				#ingenic,pinmux-cells = <2>;
				interrupts = <IRQ_GPIO2>;
				interrupt-parent = <&core_intc>;
				interrupt-controller;
				#interrupt-cells = <2>;
			};

			gpd: gpd {
				gpio-controller;
				#gpio-cells = <3>;
				#ingenic,pincfg-cells = <3>;
				#ingenic,pinmux-cells = <2>;
				interrupts = <IRQ_GPIO3>;
				interrupt-parent = <&core_intc>;
				interrupt-controller;
				#interrupt-cells = <2>;
			};

			gpe: gpe {
				gpio-controller;
				#gpio-cells = <3>;
				#ingenic,pincfg-cells = <3>;
				#ingenic,pinmux-cells = <2>;
				interrupts = <IRQ_GPIO4>;
				interrupt-parent = <&core_intc>;
				interrupt-controller;
				#interrupt-cells = <2>;
			};
		};

		uart0: serial@10030000 {
			compatible = "ingenic,x2000-uart", "ingenic,x1000-uart";
			reg = <0x10030000 0x100>;
			interrupt-parent = <&core_intc>;
			interrupts = <IRQ_UART0>;
			clocks = <&clock CLK_EXT>, <&clock CLK_GATE_UART0>;
			clock-names = "baud", "module";
			status = "disabled";
		};
		uart1: serial@10031000 {
			compatible = "ingenic,x2000-uart", "ingenic,x1000-uart";
			reg = <0x10031000 0x100>;
			interrupt-parent = <&core_intc>;
			interrupts = <IRQ_UART1>;
			clocks = <&clock CLK_EXT>, <&clock CLK_GATE_UART1>;
			clock-names = "baud", "module";
			status = "disabled";
		};
		uart2: serial@10032000 {
			compatible = "ingenic,x2000-uart", "ingenic,x1000-uart";
			reg = <0x10032000 0x100>;
			interrupt-parent = <&core_intc>;
			interrupts = <IRQ_UART2>;
			clocks = <&clock CLK_EXT>, <&clock CLK_GATE_UART2>;
			clock-names = "baud", "module";
			status = "disabled";
		};
		uart3: serial@10033000 {
			compatible = "ingenic,x2000-uart", "ingenic,x1000-uart";
			reg = <0x10033000 0x100>;
			interrupt-parent = <&core_intc>;
			interrupts = <IRQ_UART3>;
			clocks = <&clock CLK_EXT>, <&clock CLK_GATE_UART3>;
			clock-names = "baud", "module";
			status = "disabled";
		};

		uart4: serial@10034000 {
			compatible = "ingenic,x2000-uart", "ingenic,x1000-uart";
			reg = <0x10034000 0x100>;
			interrupt-parent = <&core_intc>;
			interrupts = <IRQ_UART4>;
			clocks = <&clock CLK_EXT>, <&clock CLK_GATE_UART4>;
			clock-names = "baud", "module";
			status = "disabled";
		};
		uart5: serial@10035000 {
			compatible = "ingenic,x2000-uart", "ingenic,x1000-uart";
			reg = <0x10035000 0x100>;
			interrupt-parent = <&core_intc>;
			interrupts = <IRQ_UART5>;
			clocks = <&clock CLK_EXT>, <&clock CLK_GATE_UART5>;
			clock-names = "baud", "module";
			status = "disabled";
		};
		uart6: serial@10036000 {
			compatible = "ingenic,x2000-uart", "ingenic,x1000-uart";
			reg = <0x10036000 0x100>;
			interrupt-parent = <&core_intc>;
			interrupts = <IRQ_UART6>;
			clocks = <&clock CLK_EXT>, <&clock CLK_GATE_UART6>;
			clock-names = "baud", "module";
			status = "disabled";
		};
		uart7: serial@10037000 {
			compatible = "ingenic,x2000-uart", "ingenic,x1000-uart";
			reg = <0x10037000 0x100>;
			interrupt-parent = <&core_intc>;
			interrupts = <IRQ_UART7>;
			clocks = <&clock CLK_EXT>, <&clock CLK_GATE_UART7>;
			clock-names = "baud", "module";
			status = "disabled";
		};

		uart8: serial@10038000 {
			compatible = "ingenic,x2000-uart", "ingenic,x1000-uart";
			reg = <0x10038000 0x100>;
			interrupt-parent = <&core_intc>;
			interrupts = <IRQ_UART8>;
			clocks = <&clock CLK_EXT>, <&clock CLK_GATE_UART8>;
			clock-names = "baud", "module";
			status = "disabled";
		};
		uart9: serial@10039000 {
			compatible = "ingenic,x2000-uart", "ingenic,x1000-uart";
			reg = <0x10039000 0x100>;
			interrupt-parent = <&core_intc>;
			interrupts = <IRQ_UART9>;
			clocks = <&clock CLK_EXT>, <&clock CLK_GATE_UART9>;
			clock-names = "baud", "module";
			status = "disabled";
		};

		i2c0: i2c@10050000 {
			compatible = "ingenic,x2000-i2c", "ingenic,x1000-i2c";
			reg = <0x10050000 0x1000>;
			interrupt-parent = <&core_intc>;
			interrupts = <IRQ_I2C0>;
			clocks = <&clock CLK_GATE_SMB0>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		i2c1: i2c@10051000 {
			compatible = "ingenic,x2000-i2c", "ingenic,x1000-i2c";
			reg = <0x10051000 0x1000>;
			interrupt-parent = <&core_intc>;
			interrupts = <IRQ_I2C1>;
			clocks = <&clock CLK_GATE_SMB1>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		i2c2: i2c@10052000 {
			compatible = "ingenic,x2000-i2c", "ingenic,x1000-i2c";
			reg = <0x10052000 0x1000>;
			interrupt-parent = <&core_intc>;
			interrupts = <IRQ_I2C2>;
			clocks = <&clock CLK_GATE_SMB2>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		i2c3: i2c@10053000 {
			compatible = "ingenic,x2000-i2c", "ingenic,x1000-i2c";
			reg = <0x10053000 0x1000>;
			interrupt-parent = <&core_intc>;
			interrupts = <IRQ_I2C3>;
			clocks = <&clock CLK_GATE_SMB3>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		i2c4: i2c@10054000 {
			compatible = "ingenic,x2000-i2c", "ingenic,x1000-i2c";
			reg = <0x10054000 0x1000>;
			interrupt-parent = <&core_intc>;
			interrupts = <IRQ_I2C4>;
			clocks = <&clock CLK_GATE_SMB4>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		i2c5: i2c@10055000 {
			compatible = "ingenic,x2000-i2c", "ingenic,x1000-i2c";
			reg = <0x10055000 0x1000>;
			interrupt-parent = <&core_intc>;
			interrupts = <IRQ_I2C5>;
			clocks = <&clock CLK_GATE_SMB5>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		dtrng: trng@10072000 {
			compatible = "ingenic,x2000-dtrng";
			reg = <0x10072000 0xc>;
			clocks = <&clock CLK_GATE_DTRNG>;
			status = "disabled";
		};

		otg_phy: usb-phy@1000003c {
			compatible = "ingenic,x2000-phy";
			reg = <0x1000003c 0x10>;
			clocks = <&clock CLK_OTG_PHY>;
			#phy-cells = <0>;
			status = "disabled";
		};
	};

	ahb2 {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <>;

		msc0: msc@13450000 {
			compatible = "ingenic,sdhci";
			reg = <0x13450000 0x10000>;
			status = "disabled";
			interrupt-parent = <&core_intc>;
			interrupts = <IRQ_MSC0>;
		};

		msc1: msc@13460000 {
			compatible = "ingenic,sdhci";
			reg = <0x13460000 0x10000>;
			status = "disabled";
			interrupt-parent = <&core_intc>;
			interrupts = <IRQ_MSC1>;
		};

		msc2: msc@13490000 {
			compatible = "ingenic,sdhci";
			reg = <0x13490000 0x10000>;
			status = "disabled";
			interrupt-parent = <&core_intc>;
			interrupts = <IRQ_MSC2>;
		};

		otg: otg@13500000 {
			compatible = "ingenic,x2000-otg";
			reg = <0x13500000 0x40000>;
			interrupt-parent = <&core_intc>;
			interrupts = <IRQ_OTG>;
			clocks = <&clock CLK_GATE_OTG>;
			clock-names = "otg";
			phys = <&otg_phy>;
			phy-names = "usb2-phy";
			g-rx-fifo-size = <1096>;
			g-np-tx-fifo-size = <512>;
			g-tx-fifo-size = <16 16 16 128 256 256 512 768>;
			otg-rev = <0x200>;
			status = "disabled";
		};
	};

	ahb0 {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <>;

		helix: helix@13200000 {
			compatible = "ingenic,x2000-helix";
			reg = <0x13200000 0x100000>;
			interrupt-parent = <&core_intc>;
			interrupts = <IRQ_HELIX>;
			status = "disabled";
		};
	};
};

#include "x2000-pinctrl.dtsi"
