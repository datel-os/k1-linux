# Ingenic's SDK platform code for the XBurst2 SoCs, cut down to the X2000.

if MACH_XBURST2

# Upstream's pin control driver compiles its X2000 tables in under this symbol
# and the X2000's clock, interrupt controller and timer drivers are built by
# default with it. Upstream has no option that sets it: the X2000 has no platform
# there.
config MACH_X2000
	bool

config SOC_X2000
	def_bool y
	select MACH_X2000
	select PINCTRL
	select PINCTRL_INGENIC
	select TIMER_OF

config EXTAL_CLOCK
	int "extal clock in MHz"
	default 24

endif
