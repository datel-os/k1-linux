# Ingenic's SDK platform code for the XBurst2 SoCs, cut down to the X2000.
# The drivers that go with it are in module_drivers/.

if MACH_XBURST2

config SOC_X2000
	def_bool y
	select CLKDEV_LOOKUP
	select CLKSRC_INGENIC_CORE_OST
	select CLK_X2000
	select INGENIC_INTC_CHIP
	select IRQ_INGENIC_CPU
	select PINCTRL
	select PINCTRL_INGENIC_V2
	select TIMER_OF

config EXTAL_CLOCK
	int "extal clock in MHz"
	default 24

source "module_drivers/Kconfig"

endif
