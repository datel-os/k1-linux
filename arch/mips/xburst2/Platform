load-$(CONFIG_MACH_XBURST2)	+= 0xffffffff80010000

# The boot loaders of the X2000 boards take a legacy U-Boot image that is not
# compressed, load it at 0x80f00000 and jump there; they cannot unpack one
# themselves. uzImage.bin is that: the self-extracting vmlinuz in a U-Boot
# header. It replaces vmlinuz as the default target: the two are made by
# separate runs of make in arch/mips/boot/compressed, which collide when they
# run at the same time.
zload-$(CONFIG_MACH_XBURST2)	+= 0xffffffff80f00000
all-$(CONFIG_MACH_XBURST2)	:= uzImage.bin

# The SDK's drivers, linked after the kernel's own as in the SDK
drivers-$(CONFIG_MACH_XBURST2)	+= module_drivers/

cflags-$(CONFIG_MACH_XBURST2)	+= -I$(srctree)/arch/mips/xburst2/core/include
cflags-$(CONFIG_SOC_X2000)	+= -I$(srctree)/arch/mips/xburst2/soc-x2000/include

# The SDK builds the kernel with -mnan=legacy; a compiler configured for
# IEEE 754-2008 NaNs, as the Datel OS one is, would mark the objects otherwise.
# No code is known to depend on it. It is kept so that the first 6.18 kernel
# differs from the one the printer runs in as little as possible.
cflags-$(CONFIG_MACH_XBURST2)	+= -mnan=legacy
